    },
    {
      "parameters": {
        "jsCode": "// 📁 PARSER CSV + VALIDATION BATCH\nconst payload = $json.body;\n\n// Validation des données d'entrée\nif (!payload.user_id) {\n  throw new Error('user_id manquant');\n}\nif (!payload.csv_data) {\n  throw new Error('csv_data manquant');\n}\n\n// Parse du CSV (format basique : url,email)\nconst csvLines = payload.csv_data.trim().split('\\n');\nconst headers = csvLines[0].split(',').map(h => h.trim());\n\n// Validation des headers\nif (!headers.includes('url')) {\n  throw new Error('Colonne \"url\" manquante dans le CSV');\n}\n\n// Parsing des lignes\nconst prospects = [];\nconst errors = [];\n\nfor (let i = 1; i < csvLines.length; i++) {\n  const line = csvLines[i];\n  if (!line.trim()) continue; // Skip lignes vides\n  \n  const values = line.split(',').map(v => v.trim());\n  const rowData = {};\n  \n  headers.forEach((header, index) => {\n    rowData[header] = values[index] || '';\n  });\n  \n  let url = rowData.url;\n  if (!url) {\n    errors.push(`Ligne ${i + 1}: URL manquante`);\n    continue;\n  }\n  \n  if (!url.startsWith('http')) {\n    url = 'https://' + url;\n  }\n  \n  let email = rowData.email || `contact@${url.replace(/^https?:\\/\\//, '').split('/')[0]}`;\n  \n  prospects.push({\n    url: url,\n    email: email,\n    lineNumber: i + 1,\n    originalData: rowData\n  });\n}\n\nconst batchId = `batch_${payload.user_id}_${Date.now()}`;\n\nreturn {\n  json: {\n    batchId: batchId,\n    userId: payload.user_id,\n    clientId: payload.client_id || 'premium-user',\n    batchName: payload.batch_name || 'Batch sans nom',\n    totalProspects: prospects.length,\n    prospects: prospects,\n    errors: errors,\n    deliveryMethod: 'dashboard',\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [96, -16],
      "id": "bcbdcdf1-a7b9-4344-96d0-4864267237ab",
      "name": "🔍 Parse CSV"
    },
    {
      "parameters": {
        "jsCode": "// 🔄 SPLIT PROSPECTS POUR TRAITEMENT INDIVIDUEL\nconst batch = $('🔍 Parse CSV').item.json;\n\nif (!batch || !Array.isArray(batch.prospects)) {\n  throw new Error(\"La liste des prospects n'a pas été trouvée.\");\n}\n\nconst items = batch.prospects.map((prospect, index) => ({\n  url: prospect.url,\n  email: prospect.email,\n  batchId: batch.batchId,\n  userId: batch.userId,\n  clientId: batch.clientId,\n  deliveryMethod: batch.deliveryMethod\n}));\n\nreturn items.map(item => ({ json: item }));"
      },
