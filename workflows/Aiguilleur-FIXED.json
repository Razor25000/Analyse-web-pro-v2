    {
      "parameters": {
        "jsCode": "// ✅ VALIDATION DES AUDITS PRÉ-CRÉÉS\nconst payload = $json.body;\n\n// Validation des données d'entrée\nif (!payload.user_id) {\n  throw new Error('user_id manquant');\n}\nif (!payload.audits || !Array.isArray(payload.audits)) {\n  throw new Error('audits array manquant ou invalide');\n}\nif (payload.audits.length === 0) {\n  throw new Error('audits array vide');\n}\n\n// Validation de chaque audit\nfor (let i = 0; i < payload.audits.length; i++) {\n  const audit = payload.audits[i];\n  if (!audit.id) {\n    throw new Error(`Audit ${i}: id manquant`);\n  }\n  if (!audit.webhookId) {\n    throw new Error(`Audit ${i}: webhookId manquant`);\n  }\n  if (!audit.url) {\n    throw new Error(`Audit ${i}: url manquante`);\n  }\n  if (!audit.email) {\n    throw new Error(`Audit ${i}: email manquant`);\n  }\n}\n\nconst batchId = payload.correlation_id || `batch_${payload.user_id}_${Date.now()}`;\n\nconsole.log(`✅ Batch validé: ${payload.audits.length} audits pré-créés reçus`);\n\nreturn {\n  json: {\n    batchId: batchId,\n    userId: payload.user_id,\n    clientId: payload.client_id || 'premium-user',\n    batchName: payload.batch_name || 'Batch sans nom',\n    planId: payload.plan_id || 'premium',\n    totalAudits: payload.audits.length,\n    audits: payload.audits,\n    deliveryMethod: payload.delivery_method || 'dashboard',\n    timestamp: new Date().toISOString(),\n    source: payload.source || 'nowts'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [96, -16],
      "id": "validate-prebuilt-audits",
      "name": "✅ Validate Pre-Created Audits"
