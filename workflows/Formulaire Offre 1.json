    {
      "parameters": {
        "jsCode": "// Récupérer les données de quota depuis l'input\nconst inputData = $input.all();\nif (!inputData || inputData.length === 0) {\n  throw new Error('Aucune donnée de quota disponible');\n}\n\nconst quotaData = inputData[0].json;\nconst finalQuotaData = Array.isArray(quotaData) ? quotaData[0] : quotaData;\n\n// Récupérer les données utilisateur\nlet userData = null;\ntry {\n  const userNode = $('Prepare User data').first();\n  userData = userNode ? userNode.json : null;\n} catch (error) {\n  console.log('Erreur lors de la récupération des données utilisateur:', error.message);\n}\n\nif (!userData) {\n  throw new Error('Données utilisateur non disponibles');\n}\n\nreturn { \n  json: {\n    user: userData,\n    quota: finalQuotaData\n  }\n};\n"
      },
