# ======================================
# TEMPLATE .env.local pour NOWTS
# ======================================
# Copiez ce fichier vers .env.local et remplissez les valeurs
# Toutes les variables marquées comme "REQUIRED" doivent être renseignées

# ======================================
# DATABASE (REQUIRED)
# ======================================

# URL de base de données PostgreSQL (Supabase recommandé)
# Pooler TRANSACTION pour l'utilisation runtime (port 6543)
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true&connection_limit=1&sslmode=require&schema=public"

# URL directe pour les migrations (port 5432)
DIRECT_URL="postgresql://user:password@host:5432/database?pgbouncer=true&connection_limit=1&sslmode=require&schema=public"

# ======================================
# AUTHENTICATION (REQUIRED)
# ======================================

# Better Auth configuration
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your-32-character-secret-key-here"

# OAuth Providers (optionnels pour développement)
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ======================================
# EMAIL SERVICES (REQUIRED)
# ======================================

# Resend API (pour envoi d'emails transactionnels)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="contact@yourdomain.com"
NEXT_PUBLIC_EMAIL_CONTACT="support@yourdomain.com"

# ======================================
# STRIPE PAYMENTS (REQUIRED)
# ======================================

# Clés Stripe (obtenir depuis dashboard.stripe.com)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# Webhook secret (pour vérifier les webhooks Stripe)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Price IDs des plans (créer dans Stripe Dashboard)
STRIPE_PRO_MONTHLY_PRICE_ID="price_pro_monthly_id"
STRIPE_PRO_YEARLY_PRICE_ID="price_pro_yearly_id"
STRIPE_PREMIUM_MONTHLY_PRICE_ID="price_premium_monthly_id"
STRIPE_PREMIUM_YEARLY_PRICE_ID="price_premium_yearly_id"

# ======================================
# N8N AUTOMATION (REQUIRED)
# ======================================

# URL de base de votre instance n8n (sans trailing slash)
N8N_WEBHOOK_BASE_URL="https://your-n8n-instance.com"

# Chemins des webhooks (doivent commencer par "/")
N8N_SINGLE_AUDIT_PATH="/webhook/formulaire-offre-gratuite"
N8N_BATCH_AUDIT_PATH="/webhook/batch-upload"

# Secret partagé pour signer les webhooks (32+ caractères recommandés)
N8N_WEBHOOK_SECRET="your-super-secure-webhook-secret-32-chars-min"

# ======================================
# SUPABASE INTEGRATION (REQUIRED)
# ======================================

# Configuration serveur Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your_supabase_service_role_key"

# Configuration client Supabase (exposées au navigateur)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# ======================================
# OPTIONAL SERVICES
# ======================================

# Nom de l'application (optionnel)
NEXT_PUBLIC_APP_NAME="NOWTS"

# UploadThing pour upload de fichiers (optionnel)
UPLOADTHING_TOKEN="your_uploadthing_token"

# PostHog Analytics (optionnel)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ======================================
# DEVELOPMENT SETTINGS
# ======================================

# Environment (development/test/production)
NODE_ENV="development"

# ======================================
# INSTRUCTIONS DE CONFIGURATION
# ======================================

# 1. DATABASE:
#    - Créer une base Supabase sur https://supabase.com
#    - Récupérer les URLs de connexion (pooler + direct)
#    - Configurer DATABASE_URL et DIRECT_URL

# 2. STRIPE:
#    - Créer compte sur https://stripe.com
#    - Récupérer les clés test depuis le dashboard
#    - Créer les produits et prix dans Stripe
#    - Configurer webhook endpoint vers /api/auth/stripe/webhook

# 3. N8N:
#    - Installer n8n (https://n8n.io)
#    - Créer les workflows avec webhooks
#    - Configurer les chemins et secret partagé

# 4. RESEND:
#    - Créer compte sur https://resend.com
#    - Récupérer API key depuis dashboard
#    - Configurer domaine vérifié

# 5. SUPABASE:
#    - Récupérer les clés depuis Settings > API
#    - Anon key est publique, Service key est privée

# ======================================
# SÉCURITÉ
# ======================================

# ⚠️  IMPORTANT :
# - Ne jamais committer .env.local dans Git
# - Utiliser des clés test en développement
# - Régénérer tous les secrets en production
# - Service keys doivent rester privées côté serveur